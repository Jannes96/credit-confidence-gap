# Data is never committed: it is reproducibly fetched and checksum-verified.
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Generated artefacts are reproducible via `make reproduce` and stay out of
# git. Deliberately published ones live under docs/ instead: docs/assets/ holds
# the two figures the README embeds (copied by `make assets`), and docs/demo/
# holds the single-case page, which GitHub Pages serves straight from the
# branch. A README that renders nothing on GitHub is a README nobody reads.
reports/figures/*
reports/metrics/*
!reports/**/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks are exploration only; outputs are noise in diffs.
.ipynb_checkpoints/

# OS / editor / tooling
.DS_Store
.vscode/
.idea/
.claude/settings.local.json
